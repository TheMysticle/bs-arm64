# Pinned inputs. Proton/Wine/DXVK are the Proton version the DLLs are built against (PROTON_TAG).
# The game runs only on the Proton versions in PROTON_TAGS: lsteamclient and wineopenxr talk to
# that Proton's own unix-side libraries.

# Toolchain
LLVM_MINGW_VERSION=20260922

# Proton version the DLLs are built against: Proton 11.0-2c (ARM64), and its submodules
PROTON_TAG=proton-11.0-2c
WINE_COMMIT=dc26e61847081a1b5cb0733dc30feba6ee575482
# Backported in patches/wine; applied only to the private, game-local C++ runtime.
WINE_CXX_EH_FIX=6964eb2b018a9029b561124269e7ceec5bde8086
DXVK_COMMIT=a6764047e587178283fcde4073ae6e1410af594f

# Proton versions the DLLs work with (must include PROTON_TAG); the installer accepts only these.
# Add a version only after testing it on the Steam Frame (docs/BUILD.md, "Keeping in sync with Proton").
PROTON_TAGS="proton-11.0-2c proton-11.0-2e"

# Built from source
OPENXR_SDK_TAG=release-1.1.45
ZLIB_VERSION=1.3.1
# BSIPA (mod loader): its Doorstop injector (winhttp.dll) is rebuilt for ARM64
BSIPA_COMMIT=977051a82d200314a9d944a0be54fece2c313115
# BSIPA versions tested with this release (bs-arm64-manifest.json). If one ships a MonoMod.Core
# without Windows ARM64 support, MONOMOD_CORE_MATCH below must match it, so install replaces it.
BSIPA_VERSIONS="4.3.7"
# Unmodified upstream MonoMod.Core package; 1.3.4 includes Windows ARM64 support.
MONOMOD_COMMIT=69fdc9debfcdf99cf6481047801b03b4eba947fe
MONOMOD_CORE_VERSION=1.3.4
MONOMOD_CORE_SHA256=0f08611a1086feacd2434c3d90cb15e311b0c99aa4ad6cfe53277dfd6d8c6ad3
# Replace BSIPA 4.3.7's original DLL and earlier bs-arm64 patched builds only.
MONOMOD_CORE_MATCH="1\.3\.3(-alpha\.dev)?\+aa4a84749"
UNITY_MONO_COMMIT=75711b4363fa58f05f953b3f95400d4d61c0ca35

# Beat Saber versions tested with this release, oldest first. They go into the release's
# bs-arm64-manifest.json (BSManager offers the ARM64 tab for these) and its notes and title.
# The install guard checks the Unity engine below, not the game version.
# 1.45.2 (2026-09-29) is a content-only patch (one new song, a beatmap timing fix, a wrong audio
# preview clip, a Level Editor input glitch): all 269 Beat Saber_Data/Managed/*.dll are
# byte-identical to 1.45.1 (md5), Beat Saber.exe and UnityPlayer.dll are untouched, and the Unity
# version is still 6000.3.19f1. Only Beat Saber_Data/globalgamemanagers changed (it embeds the
# version string, 1.45.2_28848, plus the new song data). Nothing this runtime replaces or patches did.
BS_VERSIONS="1.45.1 1.45.2"

# Fetched on the user's machine by install/bs-arm64.sh (not redistributable)
# 1.45.1's engine; the changeset was confirmed against Unity's download CDN (a real Windows ARM64
# target-support installer exists for it).
UNITY_VERSION=6000.3.19f1
UNITY_CHANGESET=7689f4515d75
# install uses the ARM64 (UWP) build of Unity's com.unity.xr.openxr package. Ideally that's the
# version the game ships: 1.45.1 ships 1.17.1 (its Runtime/windows/x64/UnityOpenXR.dll is
# byte-identical, md5 7a0aa23ff264f8537b44a7029c6ff190, to the game's own copy). But Unity dropped
# the universalwindows/arm64 build of this plugin starting at 1.17.0, and no version since ships a
# native windows/arm64 build either (checked up through 1.19.0-pre.1). 1.16.1 is the last version
# with the UWP ARM64 build the patch step needs. Pairing that native binary with the game's 1.17.1
# managed wrapper relies on Unity's native plugin ABI (IUnityInterfaces) staying stable across that
# small a gap. Verified in-headset on a Steam Frame (menu, Steam, VR, maps and mods all work). If
# VR/OpenXR misbehaves and nothing else explains it, this is the first thing to revisit.
UNITY_OPENXR_VERSION=1.16.1
