# Pinned inputs. Proton/Wine/DXVK must match the Proton build the game runs on,
# because lsteamclient and wineopenxr talk to Proton's own unix-side libraries.

# Toolchain
LLVM_MINGW_VERSION=20260922

# Proton 11.0-2c (ARM64) as shipped on the Steam Frame, and its submodules
PROTON_TAG=proton-11.0-2c
WINE_COMMIT=dc26e61847081a1b5cb0733dc30feba6ee575482
DXVK_COMMIT=a6764047e587178283fcde4073ae6e1410af594f

# Built from source
OPENXR_SDK_TAG=release-1.1.45
ZLIB_VERSION=1.3.1
# BSIPA (mod loader): its Doorstop injector (winhttp.dll) is rebuilt for ARM64
BSIPA_COMMIT=977051a82d200314a9d944a0be54fece2c313115
# MonoMod as shipped by BSIPA 4.3.7 (MonoMod.Core 1.3.3); rebuilt with the Windows ARM64 ABI fix
MONOMOD_COMMIT=aa4a8474906ded4423d222cdf9ea5cf884c32b5f
MONOMOD_CORE_VERSION=1.3.3+aa4a84749
# Our rebuild reports 1.3.3-alpha.dev+aa4a84749; match either by version prefix + commit
MONOMOD_CORE_MATCH="1\.3\.3(-alpha\.dev)?\+aa4a84749"
UNITY_MONO_COMMIT=75711b4363fa58f05f953b3f95400d4d61c0ca35

# The game version this runtime is built for (its Unity version is below)
GAME_VERSION=1.45.1
# 1.45.2 shipped 2026-09-29 as a content-only patch (one new song, a beatmap timing fix, a wrong
# audio preview clip, and a Level Editor input glitch) -- confirmed by diffing every file that
# would matter to this project: all 269 Beat Saber_Data/Managed/*.dll are byte-identical to 1.45.1
# (md5, not just version metadata), Beat Saber.exe/UnityPlayer.dll are untouched, and the Unity
# version is still 6000.3.19f1. Only Beat Saber_Data/globalgamemanagers itself changed (it embeds
# the version string plus whatever data the new song/fixes needed), which is why the version
# string bumped to 1.45.2_28848 even though nothing this runtime patches or replaces did.
GAME_VERSION_COMPAT="1.45.1 1.45.2"

# Fetched on the user's machine by install/bs-arm64.sh (not redistributable)
UNITY_VERSION=6000.3.19f1
UNITY_CHANGESET=7689f4515d75
# 1.45.1 ships com.unity.xr.openxr 1.17.1 (confirmed: its Runtime/windows/x64/UnityOpenXR.dll
# is byte-identical, md5 7a0aa23ff264f8537b44a7029c6ff190, to the game's own copy). But Unity
# dropped the universalwindows/arm64 build of this plugin starting at 1.17.0 - no version has
# ever shipped a genuine native windows/arm64 build, checked up through the latest published
# (1.19.0-pre.1). 1.16.1 is the last version with the UWP ARM64 build this project's patch
# step needs. Pairing that native binary with the game's actual 1.17.1 managed wrapper relies
# on Unity's native plugin ABI (IUnityInterfaces) being stable across that small a version gap,
# which it's designed to be - but this is a real assumption, not a certainty, and hasn't been
# confirmed working in-headset yet. If VR/OpenXR misbehaves and nothing else explains it, this
# is the first thing to revisit.
UNITY_OPENXR_VERSION=1.16.1
VCREDIST_URL=https://aka.ms/vs/17/release/vc_redist.arm64.exe
